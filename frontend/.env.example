# API Base Path Configuration
PUBLIC_BASE_PATH='http://localhost:9000'
PUBLIC_ENTRY_PATH='xxx'
PUBLIC_STYLES_PATH='XXX'
PUBLIC_PANORAMA_PATH='xxx'
PUBLIC_TIMBER_SPECIES_PATH='xxx'
PUBLIC_DISASTER_LORE_ALL_PATH='xxx'
PUBLIC_INT_ADD_LAYER_IDS='fac_poi_search,ensyurin_syouhan,national_forest_stand'
PUBLIC_GA_UA=''
PUBLIC_XENO_CANTO_API_KEY='XXX'
PUBLIC_INIT_DEBUG_MODE=0
# 素材の配信URL。空ならローカルの /minecraft/ を使用。変更後は再起動・再ビルドする。
PUBLIC_MINECRAFT_RESOURCE_URL=''

# Roblox素材の事前配置先（省略時は /roblox、未配置のIDは公開APIから取得）
PUBLIC_ROBLOX_RESOURCE_URL=''

# 本番の認証付き素材取得API（任意）。URLだけを設定し、APIキーは取得APIのサーバー側に置く。
PUBLIC_ROBLOX_ASSET_API_URL=''

# Roblox Open Cloud APIキー（legacy-asset:manage）。PUBLIC_を付けない。
# ローカル開発時の自動取得と roblox:prepare に使用。実際の値は .env.local に置く。
